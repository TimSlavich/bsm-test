# Database — SQLite for the prototype.
# Production deployments swap this for Postgres without code changes.
DATABASE_URL=sqlite+aiosqlite:///./brand_monitor.db

# Apply Alembic migrations on startup. Leave true for the prototype; in
# production set false and run `alembic upgrade head` from a migration job.
AUTO_CREATE_TABLES=true

# SERP engine: "playwright" (recommended) or "http"
SERP_ENGINE=playwright

# LLM arbiter — OpenRouter via LiteLLM (free Llama tier; swap to a paid
# model for higher throughput / no rate limits).
LITELLM_BASE_URL=https://openrouter.ai/api/v1
LITELLM_API_KEY=sk-or-REPLACE_ME
# Primary model — used when ARBITER_MODELS is empty.
ARBITER_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct:free
# Comma-separated fallback chain. Each call rotates to the next model on
# rate-limit / transient errors. Different OpenRouter providers serve
# different models, so 429 on Llama doesn't imply 429 on Gemma.
ARBITER_MODELS=openrouter/meta-llama/llama-3.3-70b-instruct:free,openrouter/meta-llama/llama-3.2-3b-instruct:free
ARBITER_PROVIDER=openrouter

# Optional Langfuse tracing (set keys to enable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

LOG_LEVEL=INFO

# In-process daily scheduler. When true, the backend runs one scheduled
# scan per active BrandKeyword at its frequency_hours cadence. Disable for
# multi-replica deployments and use an external orchestrator instead.
SCHEDULER_ENABLED=true

# On startup, ensure bundled brand seeds exist in the DB.
BOOTSTRAP_BRAND_SEEDS=true

# CORS — dashboard origin (comma-separated for multiple)
CORS_ALLOW_ORIGINS=http://localhost:5173
